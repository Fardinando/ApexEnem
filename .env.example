# ═══════════════════════════════════════════
#  VARIÁVEIS OBRIGATÓRIAS
# ═══════════════════════════════════════════

# OPENROUTER_API_KEY_V1 ... OPENROUTER_API_KEY_V10 (backend)
# OBRIGATÓRIA para correção de redação por IAs e perguntas.
# Crie conta grátis: https://openrouter.ai/keys
# Use apenas modelos ":free" (gratuitos). Veja a seção "MODELOS DE IA" abaixo.
OPENROUTER_API_KEY_V1="sk-or-v1-..."

# SUPABASE_URL (backend)
# OBRIGATÓRIA para autenticação e banco de dados.
# Obtenha em: Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://seu-projeto.supabase.co"

# SUPABASE_ANON_KEY (backend)
# OBRIGATÓRIA - chave anônima (pública) do Supabase.
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."

# VITE_SUPABASE_URL (frontend)
# OBRIGATÓRIA - mesma URL do SUPABASE_URL, mas com prefixo VITE_ para o Vite.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# VITE_SUPABASE_ANON_KEY (frontend)
# OBRIGATÓRIA - mesma chave do SUPABASE_ANON_KEY, com prefixo VITE_.
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."

# ═══════════════════════════════════════════
#  VARIÁVEIS OPCIONAIS
# ═══════════════════════════════════════════

# GROQ_API_KEY_V1 ... GROQ_API_KEY_V10 (backend)
# RECOMENDADA - provedor mais rápido para geração de aulas e questões.
# Crie conta grátis: https://console.groq.com/keys
# ATENÇÃO: a Groq só é gratuita no plano Free (sem cartão). Se a conta tiver
# cartão (plano Developer), o uso é cobrado por token. Modelo padrão: qwen/qwen3.8-27b.
GROQ_API_KEY_V1="gsk_..."

# GOOGLE_API_KEY (backend)
# Gemini Flash como fallback. Grátis: 500 req/dia (Google AI Studio).
GOOGLE_API_KEY="AIza..."

# ═══════════════════════════════════════════
#  MODELOS DE IA (APENAS GRATUITOS)
# ═══════════════════════════════════════════
# REGRA: não usar modelos pagos. Os padrões abaixo são todos gratuitos.
# No OpenRouter, use apenas modelos terminados em ":free" (preço US$ 0).
# OPENROUTER_MODELS default: google/gemma-4-31b-it:free, nvidia/nemotron-3-ultra-550b-a55b:free,
#   nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-26b-a4b-it:free, nvidia/nemotron-3.5-lightning:free
# OPENROUTER_MODELS="google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free"
# GROQ_MODEL="qwen/qwen3.8-27b"
# GEMINI_MODEL="gemini-2.5-flash"

# INTERNAL_API_KEY (backend + Render)
# OBRIGATÓRIA - segredo compartilhado entre o backend (Vercel) e o serviço de IA (Render).
# O Render só aceita chamadas que enviem este valor no header x-internal-key.
# Gere uma string aleatória forte (ex: openssl rand -hex 32).
# IMPORTANTE: o mesmo valor deve existir no Vercel E no Render.
INTERNAL_API_KEY="troque-por-uma-string-aleatoria-forte"

# RENDER_PROCESS_URL (backend)
# OBRIGATÓRIA para IA - URL pública do serviço de IA hospedado no Render.
# Ex: https://apexenem-ia.onrender.com
RENDER_PROCESS_URL="https://seu-servico.onrender.com"

# RESEND_API_KEY (backend)
# OPCIONAL - para enviar e-mails reais (confirmação de conta). Sem ela, o e-mail fica simulado.
# Crie em: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# EMAIL_FROM (backend)
# Remetente dos e-mails. Precisa ser um domínio verificado no Resend (Gmail não serve como remetente).
EMAIL_FROM="ApexEnem <onboarding@resend.dev>"

# CONTACT_EMAIL (backend)
# Destino das mensagens do formulário de contato do site.
CONTACT_EMAIL="apexenem@gmail.com"

# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN (backend)
# OPCIONAL - ativa rate limit distribuído (recomendado em 100k usuários).
# Crie em: https://upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SUPABASE_SERVICE_ROLE_KEY
# OPCIONAL - necessária apenas para setup automático de tabelas via backend.
# CUIDADO: essa chave tem acesso total ao banco.
# Também usada para criar tabelas e enviar e-mails em algumas rotas.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIs..."

# SUPABASE_MANAGEMENT_KEY
# OPCIONAL - usada para criar tabelas/consultar o schema automaticamente.
# Gere em: Supabase > Account > Access Tokens.
SUPABASE_MANAGEMENT_KEY=""

# VITE_HCAPTCHA_SITE_KEY
# OPCIONAL - obrigatória apenas se você ativou hCaptcha no Supabase.
# Para ativar: Supabase Dashboard > Authentication > Security > Bot Detection
# Site key gerada em: https://www.hcaptcha.com/
VITE_HCAPTCHA_SITE_KEY="sua-hcaptcha-site-key"

# ALLOWED_EMAILS (backend)
# OPCIONAL - restringe o cadastro a uma lista de e-mails (beta). Verificado no SERVIDOR.
# Se vazio, qualquer pessoa pode criar conta.
# Exemplo: ALLOWED_EMAILS="joao@gmail.com,maria@gmail.com"
ALLOWED_EMAILS=""

# HMAC_SECRET
# OBRIGATÓRIA - segredo para assinar tokens de confirmação no backend.
# Gere uma string aleatória forte (ex: openssl rand -hex 32)
HMAC_SECRET="sua-chave-secreta-aqui"

# ALLOWED_ORIGINS
# OPCIONAL - origens permitidas no CORS (separadas por vírgula).
# Se não definido, permite apenas localhost:5173 e localhost:3000.
# Ex: "https://apexenem.com.br,https://www.apexenem.com.br"
ALLOWED_ORIGINS="https://apexenem.com.br,https://www.apexenem.com.br"

# APP_URL (backend)
# URL pública canônica usada em links de e-mail (confirmação de conta).
# Se vazio, cai para VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL.
APP_URL="https://apexenem.com.br"

# ═══════════════════════════════════════════
#  APEXGUARDIAN (Reporte de Erros)
# ═══════════════════════════════════════════
# URL do ApexGuardian para reporte de erros.
# OPCIONAL - se não definido, o botão "Reportar Erro" usará o fallback.
VITE_APEXGUARDIAN_URL="https://apexguardian.onrender.com"

# ═══════════════════════════════════════════
#  ANÚNCIOS / ANALYTICS
# ═══════════════════════════════════════════
# VITE_ADSENSE_CLIENT - ID do AdSense (ex: ca-pub-0000000000000000).
# VITE_GA_ID         - ID do Google Analytics 4 (ex: G-XXXXXXXXXX).
# VITE_REWARDED_ENABLED - "true" ativa o anúncio recompensado (sistema de moedas).
# Os placeholders de anúncio aparecem no site mesmo sem AdSense configurado.
VITE_ADSENSE_CLIENT=""
VITE_GA_ID=""
VITE_REWARDED_ENABLED="false"

# VITE_SITE_URL (frontend)
# URL pública canônica do site (usada em SEO/JSON-LD e sitemap).
# Ex: https://apexenem.com.br
VITE_SITE_URL="https://apexenem.com.br"
